# Copy to .env and fill in. Never commit .env.
# Primary AI provider - any OpenAI-compatible endpoint.
# NVIDIA Brev (vLLM on your GPU instance), e.g.:
#   LLM_BASE_URL=http://<brev-endpoint>/v1
#   LLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
#   LLM_PROVIDER_LABEL=NVIDIA Brev (self-hosted)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=meta/llama-3.2-11b-vision-instruct
LLM_PROVIDER_LABEL=NVIDIA Build
# How images are sent: "openai" (image_url parts) or "inline_img" (<img src=...> in text)
LLM_IMAGE_MODE=openai

# Optional fallback provider, used automatically if the primary fails.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_LABEL=
LLM_FALLBACK_IMAGE_MODE=openai

# Long random string for signing the "viewing as" cookie.
SESSION_SECRET=
