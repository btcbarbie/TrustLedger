# Copy to .env and fill in. Never commit .env.
# Primary AI provider: Nebius Token Factory (OpenAI-compatible), running NVIDIA Nemotron.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_API_KEY=
LLM_PROVIDER_LABEL=Nebius Token Factory
# Default model, used for any job below that is left empty.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# One model per job (all on Token Factory):
#   VISION reads receipt screenshots; FAST reads WhatsApp chats and Ask questions;
#   REASONING does the heavy cross-checking.
LLM_VISION_MODEL=
LLM_FAST_MODEL=
LLM_REASONING_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# Reasoning models think before answering, so they need room for more tokens.
LLM_MAX_TOKENS=600
# How images are sent: "openai" (image_url parts) or "inline_img" (<img src=...> in text)
LLM_IMAGE_MODE=openai

# Optional fallback provider, used automatically if the primary fails.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_LABEL=
LLM_FALLBACK_IMAGE_MODE=openai

# Long random string for signing the "viewing as" cookie.
SESSION_SECRET=
